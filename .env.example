################################################################################
# Legend Connect — .env (пример). Скопируй в .env и заполни.
# База: jitsi/docker-jitsi-meet @ stable-11031. Реальные секреты НЕ коммитим.
################################################################################

#
# Изоляция (важно на общем сервере Legend)
#
# Префикс всех контейнеров/сети → legend-connect-* , сеть legend-connect_meet.jitsi
COMPOSE_PROJECT_NAME=legend-connect

# Куда пишутся конфиги стека на сервере
CONFIG=/opt/legend-connect/config

# Версия образов Jitsi (pin на стабильный релиз)
JITSI_IMAGE_VERSION=stable-11031

RESTART_POLICY=unless-stopped
TZ=Europe/Moscow

# Лимиты памяти JVM — сервер 4 ГБ, рядом прод Legend. Без лимитов Jitsi словит OOM.
JICOFO_MAX_MEMORY=512m
VIDEOBRIDGE_MAX_MEMORY=768m

#
# Домен / порты
#
PUBLIC_URL=https://meet.1leg.ru

# Jitsi web слушает HTTP на этих портах (127.0.0.1), TLS терминирует хостовый nginx
# см. nginx/meet.1leg.ru.conf. Порты НЕ 80/443, чтобы не конфликтовать с nginx op-dashboard.
HTTP_PORT=8000
HTTPS_PORT=8443
DISABLE_HTTPS=1
ENABLE_HTTP_REDIRECT=0

# TLS выдаёт хостовый nginx (certbot). Встроенный Let's Encrypt выключен.
# Альтернатива (если решим отдать 80/443 самому Jitsi): ENABLE_LETSENCRYPT=1 + домен/почта ниже.
#ENABLE_LETSENCRYPT=1
#LETSENCRYPT_DOMAIN=meet.1leg.ru
#LETSENCRYPT_EMAIL=admin@1leg.ru

#
# JVB (медиа) — КРИТИЧНО
#
JVB_PORT=10000
# Публичный IP сервера, который JVB сообщает клиентам. Заполнить IP нового сервера Legend.
JVB_ADVERTISE_IPS=<SERVER_PUBLIC_IP>

#
# Аутентификация: вход только по JWT (подписывает наш модуль в ЛК Legend)
#
ENABLE_AUTH=1
AUTH_TYPE=jwt
ENABLE_GUESTS=1
# Наш app id + общий секрет. СГЕНЕРИРОВАТЬ секрет: openssl rand -hex 32
JWT_APP_ID=legend_connect
JWT_APP_SECRET=<GENERATE_openssl_rand_hex_32>
JWT_ACCEPTED_ISSUERS=legend_connect
JWT_ACCEPTED_AUDIENCES=legend_connect
# Пользователь без токена НЕ создаёт комнату; moderator-флаг берётся из payload токена (по роли Legend)

#
# Фичи «из коробки» (Фаза 5) — включаем сразу разумный набор
#
ENABLE_BREAKOUT_ROOMS=1
ENABLE_LOBBY=1
ENABLE_PREJOIN_PAGE=1
ENABLE_REQUIRE_DISPLAY_NAME=1
DEFAULT_LANGUAGE=ru
# Запись (Jibri) — Фаза 8, пока выключено
#ENABLE_RECORDING=1

#
# Security — пароли сервис-компонентов. Заполнить перед первым запуском:
#   ./gen-passwords.sh  (из официального репо)  ИЛИ  вручную: openssl rand -hex 16
# НЕ переиспользовать один пароль.
#
JICOFO_AUTH_PASSWORD=
JVB_AUTH_PASSWORD=
JIGASI_XMPP_PASSWORD=
JIGASI_TRANSCRIBER_PASSWORD=
JIBRI_RECORDER_PASSWORD=
JIBRI_XMPP_PASSWORD=
